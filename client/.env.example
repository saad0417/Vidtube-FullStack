# Base path for API requests.
# Leave as /api/v1 so the Vite dev server proxy (see vite.config.js) forwards
# calls to the backend — that keeps requests same-origin, so the backend's
# httpOnly auth cookies are sent and stored correctly.
VITE_API_BASE_URL=/api/v1

# In production, point this at your deployed API origin instead, e.g.
# VITE_API_BASE_URL=https://api.your-domain.com/api/v1
