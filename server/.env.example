# Copy to .env for local development. Never commit the real .env.
# On a host (Render, Railway, Fly), set these in the dashboard instead.

PORT=8000

# MongoDB Atlas connection string, WITHOUT the database name —
# src/db/index.js appends DB_Name from src/constants.js.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net

# Exact origin of the deployed frontend, e.g. https://vidtube.vercel.app
# "*" is fine locally but should be a real origin in production.
CORS_ORIGIN=http://localhost:5173

# Long random strings. Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=10d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
